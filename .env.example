# Copia este archivo a .env (o define estas variables en tu shell / en el panel de Railway) antes
# de correr el backend. Ninguna tiene un valor por defecto inseguro a propósito — ver README.md.

# ---- Base de datos ----
DB_URL=jdbc:mysql://localhost:3306/centro_artes_musicales
DB_USERNAME=root
DB_PASSWORD=

# ---- Autenticación (JWT) ----
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# ---- Admin inicial (solo se usa si todavía no existe ningún ADMIN) ----
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NOMBRE=Administrador

# ---- Negocio ----
APP_TIMEZONE=America/Mexico_City
CLASES_LIMITE_MENSUAL=4
CLASES_HORAS_MINIMAS_REAGENDAR=4
CLASES_DURACION_DEFAULT_MINUTOS=60
PAGOS_MONTO_MENSUAL_DEFAULT=600.00

# ---- Stripe ----
# Sacadas del Dashboard de Stripe en modo de PRUEBA (https://dashboard.stripe.com/test/apikeys).
# STRIPE_SECRET_KEY nunca debe salir del backend ni llegar al frontend.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# La genera `stripe listen` en local, o el Dashboard al crear el endpoint de webhook en producción.
STRIPE_WEBHOOK_SECRET=whsec_...

# URL base del frontend desplegado (sin slash final) — el backend arma success_url/cancel_url de
# Stripe Checkout a partir de esto. En local, usa http://localhost:5500.
FRONTEND_URL=https://cedam.vercel.app
